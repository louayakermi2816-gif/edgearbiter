 {
  "id": "ea_in_tel",
  "type": "mqtt in",
  "z": "ea_tab",
  "name": "telemetry",
  "topic": "edgearbiter/telemetry",
  "qos": "0",
  "datatype": "json",
  "broker": "ea_broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0,
  "x": 130,
  "y": 80,
  "wires": [
   [
    "ea_prep"
   ]
  ]
 },
 {
  "id": "ea_prep",
  "type": "function",
  "z": "ea_tab",
  "name": "telemetry -> /policy/decide",
  "outputs": 1,
  "func": "const t = msg.payload;\nmsg.seq = t.seq;\nmsg.payload = {battery: t.battery ?? 1, queue: t.queue ?? 0, rtt_ms: t.rtt_ms ?? 20,\n    bandwidth_mbps: t.bandwidth_mbps ?? 20, arrivals: t.arrivals ?? 0, violation_rate: t.violation_rate ?? 0,\n    t_fraction: t.t_fraction ?? 0, edge_load: t.edge_load ?? flow.get('edge_load') ?? 0.3};\nmsg.headers = {'Content-Type': 'application/json'};\nmsg.url = (env.get('API_URL') || 'http://api:8000') + '/policy/decide';\nreturn msg;",
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 360,
  "y": 80,
  "wires": [
   [
    "ea_http"
   ]
  ]
 },
 {
  "id": "ea_http",
  "type": "http request",
  "z": "ea_tab",
  "name": "POST /policy/decide",
  "method": "POST",
  "ret": "obj",
  "paytoqs": "ignore",
  "url": "",
  "tls": "",
  "persist": false,
  "proxy": "",
  "insecureHTTPParser": false,
  "authType": "",
  "senderr": false,
  "headers": [],
  "x": 610,
  "y": 80,
  "wires": [
   [
    "ea_seq"
   ]
  ]
 },
 {
  "id": "ea_seq",
  "type": "function",
  "z": "ea_tab",
  "name": "answer the same seq",
  "outputs": 1,
  "func": "if (msg.statusCode !== 200) { node.warn(`policy service: HTTP ${msg.statusCode}`); return null; }\nmsg.payload.seq = msg.seq;\nreturn msg;",
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 830,
  "y": 80,
  "wires": [
   [
    "ea_out_dec",
    "ea_show_dec"
   ]
  ]
 },
 {
  "id": "ea_out_dec",
  "type": "mqtt out",
  "z": "ea_tab",
  "name": "decision",
  "topic": "edgearbiter/decision",
  "qos": "0",
  "retain": "false",
  "respTopic": "",
  "contentType": "",
  "userProps": "",
  "correl": "",
  "expiry": "",
  "broker": "ea_broker",
  "x": 1040,
  "y": 60,
  "wires": []
 },
 {
  "id": "ea_in_edge",
  "type": "mqtt in",
  "z": "ea_tab",
  "name": "edge host load",
  "topic": "edgearbiter/edge",
  "qos": "0",
  "datatype": "json",
  "broker": "ea_broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0,
  "x": 140,
  "y": 140,
  "wires": [
   [
    "ea_edge_load"
   ]
  ]
 },
 {
  "id": "ea_edge_load",
  "type": "function",
  "z": "ea_tab",
  "name": "remember edge load",
  "outputs": 1,
  "func": "flow.set('edge_load', msg.payload.edge_load);\nreturn null;",
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 370,
  "y": 140,
  "wires": [
   []
  ]
 },
 {
  "id": "ea_show_dec",
  "type": "function",
  "z": "ea_tab",
  "name": "live decision",
  "outputs": 4,
  "func": "const d = msg.payload;\nconst where = d.placement === 'edge' ? `edge (CPU share ${d.edge_share})` : 'on device';\nnode.status({fill: d.rejected ? 'yellow' : (d.placement === 'edge' ? 'blue' : 'green'), shape: 'dot',\n    text: `${d.model} @ ${d.rate_fps} fps, ${where}${d.rejected ? ' - offload rejected' : ''}`});\nconst policy = d.policy ? `device: ${d.policy.device}, edge: ${d.policy.edge}` : '';\nreturn [{payload: d.model}, {payload: where + (d.rejected ? ' (offload rejected)' : '')},\n        {payload: `${d.rate_fps} fps`}, {payload: (d.edge_accept ? `admitting, share ${d.edge_share}` : 'not admitting')\n        + (policy ? ` - ${policy}` : '')}];",
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 1040,
  "y": 140,
  "wires": [
   [
    "ea_t_model"
   ],
   [
    "ea_t_where"
   ],
   [
    "ea_t_rate"
   ],
   [
    "ea_t_edge"
   ]
  ]
 },
