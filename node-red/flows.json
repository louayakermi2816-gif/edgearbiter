[
 {
  "id": "ea_tab",
  "type": "tab",
  "label": "EdgeArbiter",
  "disabled": false,
  "info": "IoT loop in software: the (virtual) ESP32 node publishes telemetry -> this flow calls the EdgeArbiter policy service (device + edge agents) -> the decision goes back to the node over MQTT. The dashboard at /dashboard shows the live decision and KPIs. Environment: MQTT_HOST (broker), API_URL (policy service)."
 },
 {
  "id": "ea_broker",
  "type": "mqtt-broker",
  "name": "broker",
  "broker": "${MQTT_HOST}",
  "port": "1883",
  "clientid": "",
  "autoConnect": true,
  "usetls": false,
  "protocolVersion": "4",
  "keepalive": "60",
  "cleansession": true,
  "autoUnsubscribe": true
 },
 {
  "id": "ea_ui",
  "type": "ui-base",
